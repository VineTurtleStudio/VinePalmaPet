{
  "schema": 1,
  "id": "vine",
  "name": "Vine",
  "author": "VineTurtleStudio",
  "license": "CC-BY-4.0",
  "description": "Placeholder sprout pet generated by scripts/make-placeholder-pet.ps1",
  "frame": { "width": 256, "height": 256 },
  "anchor": { "x": 0.5, "y": 1.0 },
  "bubble": { "x": 0.5, "y": 0.06 },
  "animations": {
    "idle": { "file": "idle.png", "frames": 8, "fps": 7, "loop": false },
    "blink": { "file": "blink.png", "frames": 4, "fps": 12, "loop": false },
    "happy": { "file": "happy.png", "frames": 12, "fps": 14, "loop": false },
    "focus": { "file": "focus.png", "frames": 6, "fps": 6, "loop": true },
    "sleep": { "file": "sleep.png", "frames": 8, "fps": 5, "loop": true },
    "talk": { "file": "talk.png", "frames": 6, "fps": 10, "loop": true }
  },
  "states": {
    "idle": {
      "anims": ["idle", "idle", "idle", "idle", "blink", "idle", "idle", "blink"],
      "loop": true,
      "priority": 0
    },
    "pat": { "anims": ["happy"], "next": "idle", "priority": 30 },
    "celebrate": { "anims": ["happy"], "next": "idle", "priority": 40 },
    "focus": { "anims": ["focus"], "loop": true, "priority": 10 },
    "sleep": { "anims": ["sleep"], "loop": true, "priority": 20 },
    "talk": { "anims": ["talk"], "loop": true, "priority": 15 }
  }
}
